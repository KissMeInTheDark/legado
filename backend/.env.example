# 环境变量示例文件
# 复制此文件为 .env 并填写真实配置值
# 注意：.env 文件不要提交到 Git！

# MySQL
MYSQL_ROOT_PASSWORD=ReaderDB@2026

# Legado 认证（未开启认证则留空）
LEGADO_USERNAME=
LEGADO_PASSWORD=

# 阿里云 OSS（必填）
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=your-access-key-id
ALIYUN_OSS_ACCESS_KEY_SECRET=your-access-key-secret
ALIYUN_OSS_BUCKET_NAME=your-reader-bucket
ALIYUN_OSS_CDN_DOMAIN=https://cdn.your-domain.com

# JWT（必填，生产环境必须修改为随机的强密钥，至少32字符）
JWT_SECRET=change-this-to-a-random-secret-string-at-least-32-characters-long
JWT_EXPIRE_HOURS=720

# 后端 Docker 镜像（CI/CD 自动推送后更新）
BACKEND_IMAGE=reader-backend:latest
