/**
 * API 请求层 - 封装所有与后端的 HTTP 通信
 *
 * 说明：
 *  - 所有请求通过此文件统一发出，方便统一处理认证、日志、错误
 *  - 认证 Token 自动从本地存储获取，401 时自动刷新
 *  - 请求失败时统一弹出提示
 */

// 后端服务地址（根据实际部署修改）
const BASE_URL = 'https://your-backend-domain.com/api/v1'

// 本地存储 Key 常量
const STORAGE_KEY = {
  TOKEN: 'reader_token',
  USER_ID: 'reader_user_id',
  DEVICE_ID: 'reader_device_id',
}

/**
 * 获取本地存储的 Token
 */
function getToken() : string {
  return uni.getStorageSync(STORAGE_KEY.TOKEN) as string ?? ''
}

/**
 * 保存 Token 到本地存储
 */
function saveToken(token : string, userId : string) {
  uni.setStorageSync(STORAGE_KEY.TOKEN, token)
  uni.setStorageSync(STORAGE_KEY.USER_ID, userId)
}

/**
 * 核心请求方法（统一处理认证、错误、日志）
 *
 * @param method HTTP 方法
 * @param path 接口路径（不含 BASE_URL）
 * @param data 请求体/参数
 * @param isRetry 是否是 Token 刷新后的重试（避免无限循环）
 */
async function request(method : string, path : string, data : any = null, isRetry : boolean = false) : Promise<any> {
  const url = `${BASE_URL}${path}`
  const token = getToken()

  console.log(`[API请求] ${method} ${path}`, data ? JSON.stringify(data) : '')

  return new Promise((resolve, reject) => {
    uni.request({
      url,
      method: method as any,
      data: data ?? {},
      header: {
        'Content-Type': 'application/json',
        'Authorization': token ? `Bearer ${token}` : '',
      },
      success: async (res : any) => {
        const body = res.data as any
        console.log(`[API响应] ${method} ${path} code=${body?.code}`)

        if (body?.code === 200) {
          resolve(body.data)
        } else if (body?.code === 401 && !isRetry) {
          // Token 过期，尝试自动刷新
          console.warn('[API] Token 过期，尝试刷新')
          try {
            await refreshToken()
            // 刷新成功后重试原请求
            const result = await request(method, path, data, true)
            resolve(result)
          } catch (e) {
            // 刷新失败，清除本地 Token 并提示用户重新进入（首页会自动重新登录）
            console.error('[API] Token 刷新失败，清除本地Token')
            uni.removeStorageSync('reader_token')
            uni.removeStorageSync('reader_user_id')
            uni.showModal({
              title: '登录已过期',
              content: '请重新进入应用',
              showCancel: false,
              success: () => {
                // 重新登录而非 reLaunch（避免循环）
                reject(new Error('登录已过期'))
              }
            })
          }
        } else {
          const errMsg = body?.message ?? '请求失败'
          console.error(`[API错误] ${method} ${path} code=${body?.code} msg=${errMsg}`)
          uni.showToast({ title: errMsg, icon: 'error' })
          reject(new Error(errMsg))
        }
      },
      fail: (err : any) => {
        console.error(`[API网络错误] ${method} ${path}`, JSON.stringify(err))
        uni.showToast({ title: '网络错误，请检查网络连接', icon: 'error' })
        reject(new Error('网络错误'))
      }
    })
  })
}

// ==================== 用户接口 ====================

/**
 * 用户登录/注册（设备一键登录）
 * 调用时机：App 启动时
 */
export async function login(deviceId : string, nickname ?: string, avatar ?: string) : Promise<any> {
  const data = await request('POST', '/user/login', { deviceId, nickname, avatar })
  saveToken(data.token, data.userId)
  return data
}

/**
 * 刷新 Token（Token 过期时内部自动调用）
 */
async function refreshToken() : Promise<void> {
  const oldToken = getToken()
  const data = await request('POST', '/user/refresh-token', { token: oldToken }, true)
  saveToken(data.token, data.userId)
}

// ==================== 搜索接口 ====================

/**
 * 搜索书籍
 * 调用时机：用户输入关键词并点击搜索
 *
 * @param keyword 搜索关键词
 * @param timeout 搜索超时（秒）
 */
export async function searchBooks(keyword : string, timeout : number = 15) : Promise<any> {
  return await request('GET', `/search/books?keyword=${encodeURIComponent(keyword)}&timeout=${timeout}`)
}

// ==================== 书架接口 ====================

/**
 * 获取书架列表（含阅读进度）
 * 调用时机：书架页面加载时
 */
export async function getBookshelf() : Promise<any> {
  return await request('GET', '/bookshelf')
}

/**
 * 将书籍加入书架并触发后台下载
 * 调用时机：搜索结果点击「阅读」时
 */
export async function addBook(bookInfo : any) : Promise<any> {
  return await request('POST', '/books/add', bookInfo)
}

/**
 * 查询书籍下载进度（用于轮询）
 */
export async function getDownloadStatus(bookId : string) : Promise<any> {
  return await request('GET', `/books/${bookId}/download-status`)
}

/**
 * 从书架移除书籍
 */
export async function removeBook(bookId : string) : Promise<any> {
  return await request('DELETE', `/bookshelf/${bookId}`)
}

// ==================== 章节接口 ====================

/**
 * 获取章节列表（前端应缓存到本地）
 *
 * @param bookId 书籍ID
 * @param page 页码
 * @param size 每页条数
 */
export async function getChapterList(bookId : string, page : number = 1, size : number = 200) : Promise<any> {
  return await request('GET', `/books/${bookId}/chapters?page=${page}&size=${size}`)
}

/**
 * 获取单个章节的 OSS 预签名 URL
 * 调用时机：阅读器需要加载某章节时
 */
export async function getChapterUrl(bookId : string, chapterIdx : number) : Promise<any> {
  return await request('GET', `/books/${bookId}/chapters/${chapterIdx}/url`)
}

/**
 * 批量获取章节预签名 URL（预加载相邻章节）
 * 调用时机：阅读器加载当前章节时，预加载前后各2章
 */
export async function getBatchChapterUrls(bookId : string, chapterIdxList : number[]) : Promise<any> {
  return await request('POST', `/books/${bookId}/chapters/batch-urls`, { chapterIdxList })
}

// ==================== 阅读进度接口 ====================

/**
 * 上报阅读进度
 * 调用时机：翻页（节流30秒）、退出阅读器时、App进入后台时
 */
export async function reportProgress(bookId : string, chapterIndex : number, chapterPos : number, chapterTitle : string, readTime : number) : Promise<any> {
  return await request('POST', '/progress/report', {
    bookId,
    durChapterIndex: chapterIndex,
    durChapterPos: chapterPos,
    durChapterTitle: chapterTitle,
    readTime
  })
}

/**
 * 查询阅读进度（打开书籍时同步服务端进度）
 */
export async function getProgress(bookId : string) : Promise<any> {
  return await request('GET', `/progress/${bookId}`)
}

/**
 * 从 OSS 预签名 URL 下载章节文本内容
 * 调用时机：获取到预签名 URL 后，前端直接请求 OSS 下载内容
 *
 * @param presignedUrl OSS 预签名 URL
 */
export async function downloadChapterContent(presignedUrl : string) : Promise<string> {
  return new Promise((resolve, reject) => {
    uni.request({
      url: presignedUrl,
      method: 'GET',
      success: (res : any) => {
        resolve(res.data as string)
      },
      fail: (err : any) => {
        console.error('[API] 下载章节内容失败', JSON.stringify(err))
        reject(new Error('章节内容下载失败'))
      }
    })
  })
}
